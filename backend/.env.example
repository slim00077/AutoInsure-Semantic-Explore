# Port de l'API Express
PORT=4000
# Origine autorisée par CORS (URL du front React)
CORS_ORIGIN=http://localhost:5173
# URL du service sémantique Python (RDFLib + NLP spaCy)
SEMANTIC_URL=http://127.0.0.1:8001
# Dossier de données secondaires (historiques, journal d'activité). L'ontologie reste la source de vérité.
DATA_DIR=../data
# Niveau de logs : debug | info | warn | error
LOG_LEVEL=info
# AUCUNE clé d'API LLM n'est utilisée ni nécessaire dans ce projet.
